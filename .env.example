# OpenCovers — environment variables for local development.
#
#   cp .env.example .env     (then uncomment only what you need to override)
#
# Local development works with NO .env at all: every variable below has a safe
# default for localhost. The API loads ../../.env automatically when the file
# exists (see the `dev`, `start` and `db:migrate` scripts in apps/api).
#
# Every line is commented out on purpose. The code reads `process.env.X ?? default`,
# so an EMPTY value (`PORT=`) would override the default with an empty string.
# Uncomment a line only when you give it a real value. Never commit a real .env.
#
# For the production Docker stack use .env.prod.example instead (compose.prod.yaml).

# --- API (apps/api) ----------------------------------------------------------

# PostgreSQL connection string for the dev database.
# Default: postgres://postgres:postgres@localhost:5432/opencovers
# Comes from `docker compose up -d` (compose.yaml) or your own PostgreSQL 16.
# DATABASE_URL=

# Port the API listens on. Default: 3000.
# The staff app dev server proxies /api and /v1 to http://localhost:3000.
# PORT=

# Secret that signs sessions (Better Auth). Default: an insecure dev value.
# REQUIRED in any shared or production environment. Generate: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Public URL of the API as users reach it. Default: http://localhost:3000
# BETTER_AUTH_URL=

# Comma-separated browser origins allowed to sign in / call the API.
# Default: the local dev origins. Set it to your public URL when you deploy.
# TRUSTED_ORIGINS=

# Email confirmations through Resend. Optional: with these unset, no email is sent.
# RESEND_API_KEY is created at https://resend.com/api-keys (a secret).
# RESEND_FROM_EMAIL is a sender on a domain you verified in Resend.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# --- Tests (apps/api) --------------------------------------------------------

# Database the integration tests wipe and use. Default:
# postgres://postgres:postgres@localhost:5432/opencovers_test
# Never point it at data you care about. compose.yaml creates opencovers_test.
# TEST_DATABASE_URL=

# Test-only switch for the webhook end-to-end test (allows plain-HTTP targets).
# Leave it unset outside tests.
# WEBHOOK_ALLOW_INSECURE=

# --- MCP server (apps/mcp) ---------------------------------------------------

# Base URL of the API the MCP server talks to. Default: http://localhost:3000
# OPENCOVERS_BASE_URL=

# Agent key the MCP server authenticates with (a secret). Create it in the staff
# app under Setup → API keys (venue admins only). It is usually set in the MCP
# host's config (Claude Desktop, Cursor), not here.
# OPENCOVERS_API_KEY=
