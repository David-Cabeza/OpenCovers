# The hosted demo (ADR-0022). Copy to .env.demo on the demo server and fill the blanks. Never commit .env.demo.
# Run: docker compose --env-file .env.demo -f compose.demo.yaml up -d --build
# Runbook: docs/deploy.md#hosted-demo. Run this stack on its own host and database, never next to real data.

# Public origin of the staff app and the API. Used for sign-in links, CORS and the cookie domain. Must be https.
PUBLIC_URL=https://demo.opencovers.dev
# Caddy site address of the staff app. A real domain turns on automatic HTTPS.
SITE_ADDRESS=demo.opencovers.dev
# The guest booking widget's own host. It must not be the staff app's host name.
WIDGET_ADDRESS=book.demo.opencovers.dev
HTTP_PORT=80
HTTPS_PORT=443

# Letters and digits only. The value is placed inside the database URL.
POSTGRES_PASSWORD=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Keys the guest blocklist hashes. openssl rand -base64 32, a different value from BETTER_AUTH_SECRET.
BLOCKLIST_KEY=

# Signs the sign-in challenges, at least 32 characters. openssl rand -base64 32. Optional with one API process;
# without it a restart voids the challenges open at that moment and the API logs a warning.
PUBLIC_CHALLENGE_SECRET=

# Magic links are sent with Resend, so both are required: the demo cannot sign anyone in without them.
# RESEND_FROM_EMAIL must be an address on a domain verified in Resend, such as OpenCovers <demo@opencovers.dev>.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google sign-in. Both or neither. Leave both empty to offer the magic link only.
# Authorized redirect URI in the Google OAuth client: https://demo.opencovers.dev/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Fixed by the stack, shown for reference: DEMO_MODE=1, NODE_ENV=production, SIGNUP=closed, TRUST_PROXY=true.
# Keep TRUST_PROXY=true: Caddy is the only way to the API and sets the client address. Never publish the api port.
TRUST_PROXY=true

# Optional caps. Empty or unset keeps the default shown. Per sandbox:
# DEMO_MAX_RESERVATIONS=150
# DEMO_MAX_GUESTS=100
# DEMO_MAX_WAITLIST=60
# DEMO_MAX_TABLES=40
# DEMO_MAX_SERVICES=8
# DEMO_MAX_FLOOR_ITEMS=40
# DEMO_MAX_INVITATIONS=20
# DEMO_MAX_API_KEYS=10
# DEMO_MAX_BLOCKLIST=50
# For the whole demo: live sandboxes, and sandboxes created in the last 24 hours.
# DEMO_MAX_SANDBOXES=500
# DEMO_MAX_NEW_PER_DAY=100
# Sandboxes built at once (keep at least 3 below DATABASE_POOL_MAX, default 10) and sign-ins waiting.
# DEMO_PROVISION_CONCURRENCY=3
# DEMO_PROVISION_QUEUE=50

# Optional rate limits, max/window with a window in s, m or h. Defaults shown.
# RATE_LIMIT_MAGIC_LINK=1/1m
# RATE_LIMIT_MAGIC_LINK_DAY=5/24h
# RATE_LIMIT_MAGIC_LINK_IP=10/1h
# RATE_LIMIT_DEMO_CHALLENGE=60/1h
# Remote MCP stays off in the demo: the API refuses to start with MCP_REMOTE=on and DEMO_MODE=1.
# MCP_REMOTE=off
# RATE_LIMIT_AUTH=30/15m
# PUBLIC_POW_DIFFICULTY=12
