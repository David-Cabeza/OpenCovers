# Production environment for the API. Copy to .env.production and fill in.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/opencovers

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the API.
BETTER_AUTH_URL=https://api.example.com

# Comma-separated origins allowed to call auth (the deployed staff app).
TRUSTED_ORIGINS=https://app.example.com

# Port the API listens on (defaults to 3000).
PORT=3000
