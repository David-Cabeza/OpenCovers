{$SITE_ADDRESS:http://localhost} {
	encode gzip

	# Above the API's own limits (256 KB, and 16 KB under /v1/public), which answer with the JSON error.
	request_body {
		max_size 1MiB
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000"

	# The hosted demo only (NOINDEX=on in compose.demo.yaml): fake data, kept out of search engines. Off, nothing changes.
	@noindex expression `"{$NOINDEX:off}" == "on"`
	header @noindex X-Robots-Tag "noindex, nofollow"
	@noindex_robots {
		expression `"{$NOINDEX:off}" == "on"`
		path /robots.txt
	}
	handle @noindex_robots {
		header Content-Type "text/plain; charset=utf-8"
		respond `User-agent: *
Disallow: /
` 200
	}

	handle /health {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# The booking widget never shares the staff origin in production (ADR-0017, Q1). It has its own site below.
	# The 404 reads as a page, not as a blank screen. Styles are attributes, because `{` opens a placeholder here.
	handle /w/* {
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><html lang='es'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><meta name='robots' content='noindex'><title>Esta dirección no existe</title></head><body style='font:16px/1.5 system-ui,sans-serif;max-width:28rem;margin:4rem auto;padding:0 16px;color:#1f2933'><h1 style='font-size:1.25rem'>Aquí no hay nada que reservar</h1><p>Esta dirección no existe o ya no está activa. Reserva desde la web del restaurante o llámalo directamente.</p><p lang='en' style='color:#52606d'>There is nothing to book here. Book from the restaurant's website or call them directly.</p></body></html>" 404
	}

	handle /r {
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><html lang='es'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><meta name='robots' content='noindex'><title>Esta dirección no existe</title></head><body style='font:16px/1.5 system-ui,sans-serif;max-width:28rem;margin:4rem auto;padding:0 16px;color:#1f2933'><h1 style='font-size:1.25rem'>Aquí no hay nada que reservar</h1><p>Esta dirección no existe o ya no está activa. Reserva desde la web del restaurante o llámalo directamente.</p><p lang='en' style='color:#52606d'>There is nothing to book here. Book from the restaurant's website or call them directly.</p></body></html>" 404
	}

	# The guest API belongs to the widget host too, so the staff host exposes less. Only when WIDGET_ADDRESS is set:
	# without it there is no widget host, and the staff host keeps forwarding /v1/public/* as before.
	@guest_api_off {
		expression `"{$WIDGET_ADDRESS:}" != ""`
		path /v1/public/*
	}
	handle @guest_api_off {
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><html lang='es'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><meta name='robots' content='noindex'><title>Esta dirección no existe</title></head><body style='font:16px/1.5 system-ui,sans-serif;max-width:28rem;margin:4rem auto;padding:0 16px;color:#1f2933'><h1 style='font-size:1.25rem'>Aquí no hay nada que reservar</h1><p>Esta dirección no existe o ya no está activa. Reserva desde la web del restaurante o llámalo directamente.</p><p lang='en' style='color:#52606d'>There is nothing to book here. Book from the restaurant's website or call them directly.</p></body></html>" 404
	}

	handle /v1/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# Remote MCP (ADR-0014): the endpoint and the OAuth metadata, only with MCP_REMOTE=on. Off, these paths stay the
	# staff app's, as before. The OAuth routes themselves are under /api, which the API answers with 404 while off.
	@mcp_remote {
		expression `"{$MCP_REMOTE:off}" == "on"`
		path /mcp /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	}
	handle @mcp_remote {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# The booking widget's own origin (ADR-0017 section 1). The API writes the page with frame-ancestors per venue,
# so this block sends no X-Frame-Options and no frame-ancestors of its own on /w/*. The default address names
# a host that never resolves, so the block serves nothing until WIDGET_ADDRESS is set.
{$WIDGET_ADDRESS:http://widget.invalid} {
	encode gzip

	request_body {
		max_size 64KiB
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000"

	# The hosted demo only (NOINDEX=on in compose.demo.yaml): fake data, kept out of search engines. Off, nothing changes.
	@noindex expression `"{$NOINDEX:off}" == "on"`
	header @noindex X-Robots-Tag "noindex, nofollow"
	@noindex_robots {
		expression `"{$NOINDEX:off}" == "on"`
		path /robots.txt
	}
	handle @noindex_robots {
		header Content-Type "text/plain; charset=utf-8"
		respond `User-agent: *
Disallow: /
` 200
	}

	handle /w/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# The self-service page. The API sends its headers, frame-ancestors 'none' among them.
	handle /r {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# Browsers ask for it on every page. The API answers 204 on this host.
	handle /favicon.ico {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle /v1/public/* {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle {
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><html lang='es'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><meta name='robots' content='noindex'><title>Esta dirección no existe</title></head><body style='font:16px/1.5 system-ui,sans-serif;max-width:28rem;margin:4rem auto;padding:0 16px;color:#1f2933'><h1 style='font-size:1.25rem'>Aquí no hay nada que reservar</h1><p>Esta dirección no existe o ya no está activa. Reserva desde la web del restaurante o llámalo directamente.</p><p lang='en' style='color:#52606d'>There is nothing to book here. Book from the restaurant's website or call them directly.</p></body></html>" 404
	}
}
