# Public origin users type in the browser. Used for sign-in and CORS.
PUBLIC_URL=http://localhost
# Caddy site address. A real domain turns on automatic HTTPS.
SITE_ADDRESS=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

# Letters and digits only. The value is placed inside the database URL.
POSTGRES_PASSWORD=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional. Needed only to send email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
