# Public origin users type in the browser. Used for sign-in and CORS.
PUBLIC_URL=http://localhost
# Caddy site address. A real domain turns on automatic HTTPS.
SITE_ADDRESS=http://localhost
# Optional. The guest booking widget's own host, such as book.example.com, with HTTPS.
# It must not be the staff app's host name. Unset, the stack serves no widget page.
# See docs/deploy.md#booking-widget.
# WIDGET_ADDRESS=
HTTP_PORT=80
HTTPS_PORT=443

# Letters and digits only. The value is placed inside the database URL.
POSTGRES_PASSWORD=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Keys the guest blocklist hashes. openssl rand -base64 32, a different value from
# BETTER_AUTH_SECRET. Keep it out of database backups. During a rotation, move the old
# value to BLOCKLIST_KEY_PREVIOUS. See docs/adr/0018-guest-blocklist.md.
BLOCKLIST_KEY=
# BLOCKLIST_KEY_PREVIOUS=

# Who may create an account. Default first-user: the first account can sign up,
# then sign-up closes. Other values: open (anyone), closed (nobody).
# Create your own account before you publish the address.
SIGNUP=first-user

# Rate limits on sign-in, sign-up and invitation redemption. Keep TRUST_PROXY=true:
# Caddy is the only way to the API and sets the client address. Never publish the api port.
# Optional budgets, shown with their defaults (max/window, window in s, m or h):
# RATE_LIMIT=on (the compose stack sets NODE_ENV=production and defaults this to on)
# RATE_LIMIT_AUTH=30/15m
# RATE_LIMIT_SIGNUP=5/1h
# RATE_LIMIT_INVITATION=10/15m
# RATE_LIMIT_VENUE_CREATION=10/1h
TRUST_PROXY=true

# Remote MCP over OAuth 2.1 (docs/adr/0014-remote-mcp-oauth.md). Default off. On, the API refuses to
# start unless PUBLIC_URL is https and BETTER_AUTH_SECRET is set, and Caddy forwards /mcp and the
# OAuth metadata to the API. The /mcp endpoint itself is not built yet (issue #67).
# MCP_REMOTE=off
# RATE_LIMIT_OAUTH_AUTHORIZE=30/15m
# RATE_LIMIT_OAUTH_TOKEN=60/15m

# Allergies and diets on a reservation (docs/adr/0027-allergies-and-dietary-needs.md). Default off.
# It is health data: do not turn it on for real guests before the legal review of that record.
# DIETARY=off

# Optional. Needed only to send email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
