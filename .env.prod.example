# Public origin users type in the browser. Used for sign-in and CORS.
PUBLIC_URL=http://localhost
# Caddy site address. A real domain turns on automatic HTTPS.
SITE_ADDRESS=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

# Letters and digits only. The value is placed inside the database URL.
POSTGRES_PASSWORD=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Who may create an account. Default first-user: the first account can sign up,
# then sign-up closes. Other values: open (anyone), closed (nobody).
# Create your own account before you publish the address.
SIGNUP=first-user

# Rate limits on sign-in, sign-up and invitation redemption. Keep TRUST_PROXY=true:
# Caddy is the only way to the API and sets the client address. Never publish the api port.
# Optional budgets, shown with their defaults (max/window, window in s, m or h):
# RATE_LIMIT=on (the compose stack sets NODE_ENV=production and defaults this to on)
# RATE_LIMIT_AUTH=30/15m
# RATE_LIMIT_SIGNUP=5/1h
# RATE_LIMIT_INVITATION=10/15m
# RATE_LIMIT_VENUE_CREATION=10/1h
TRUST_PROXY=true

# Optional. Needed only to send email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
